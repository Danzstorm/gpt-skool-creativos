# =============================================================================
# GPT Creativos — variables de entorno
# Copia este archivo a `.env.local` (local) y carga las mismas en Vercel.
# NO subas `.env.local` a git (ya está en .gitignore).
# Guía completa: docs/GUIA-DE-USO.md
# =============================================================================

# --- Supabase (obligatorio) --------------------------------------------------
# Project Settings → API. La service_role es SECRETA: solo servidor, nunca NEXT_PUBLIC.
NEXT_PUBLIC_SUPABASE_URL=https://<tu-proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- OpenAI (obligatorio) ----------------------------------------------------
# Todos los mensajes de chat se facturan a esta cuenta.
OPENAI_API_KEY=sk-...

# --- Skool (obligatorio) -----------------------------------------------------
# Link público del Skool (botón "Unirme / renovar" en acceso denegado).
NEXT_PUBLIC_SKOOL_URL=https://www.skool.com/tu-comunidad
# Secreto compartido con Zapier/Make para el webhook de altas/bajas.
# Genera uno aleatorio: `openssl rand -hex 24`
SKOOL_WEBHOOK_SECRET=<secreto-aleatorio>

# --- Upstash Redis (opcional; recomendado en producción) ---------------------
# Sin esto el rate limiting es por instancia serverless, no global.
# Integración nativa de Vercel (un clic) o crea la DB en upstash.com.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Google login (opcional) -------------------------------------------------
# Ponlo en "true" SOLO después de configurar el provider Google en
# Supabase Auth (client id/secret de Google Cloud). Si no, el botón de la
# pantalla de login falla y no se muestra.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# --- Sitio (opcional) --------------------------------------------------------
# URL canónica para metadata. En Vercel se infiere de VERCEL_URL si se omite;
# fija tu dominio propio para canonical/OG correctos.
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com

# --- Gobernanza de Storage (opcional; scripts + Action semanal) --------------
# Techo del plan de Supabase. Pro = 100 GB (default). Free = 1: hay que setearlo
# o el auto-borrado no dispara nunca (el umbral se queda en 80 GB).
# STORAGE_QUOTA_GB=100
# Auto-borrado solo si el uso MEDIDO supera este valor. Default: 80% de la cuota
# (80 GB en Pro). Con ~19 GB de 100 no dispara. Vacío/inválido = default alto.
# STORAGE_CLEAN_THRESHOLD_GB=80
