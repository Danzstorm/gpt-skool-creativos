{
  "name": "gpt-creativos",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm run test:run && npm run build",
    "deploy:prod": "node scripts/deploy-prod.mjs",
    "audit:data-model": "node --env-file=.env.local scripts/audit-data-model.mjs",
    "backfill:gpt-config": "node --env-file=.env.local scripts/backfill-gpt-config.mjs",
    "backfill:messages": "node --env-file=.env.local scripts/backfill-thread-messages.mjs",
    "cleanup:orphans": "node --env-file=.env.local scripts/cleanup-orphans.mjs",
    "cleanup:orphan-users": "node --env-file=.env.local scripts/cleanup-orphan-users.mjs",
    "admin:bootstrap": "node --env-file=.env.local scripts/bootstrap-admin.mjs",
    "pilot:video": "node --env-file=.env.local scripts/pilot-video-prompt.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-switch": "^1.3.1",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "@types/papaparse": "^5.5.2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "ai": "^7.0.7",
    "clsx": "^2.1.1",
    "lucide-react": "^1.22.0",
    "next": "16.2.12",
    "openai": "^6.45.0",
    "papaparse": "^5.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
